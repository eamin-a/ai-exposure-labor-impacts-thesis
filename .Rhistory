panel_q <- read_csv('./data/checkpoints/ready/panel_q.csv')
restricted_panel <- panel_q %>% filter(beta_quintile %in% c(1,5))
lm.fit <- feols(Y_SHARE ~ i(QUARTER, beta_quintile_5, ref = -1) | OCC + QUARTER,
data = restricted_panel, cluster = "OCC")
betahat_full <- coef(lm.fit)
sigma_full   <- vcov(lm.fit)
event_vars <- grep("QUARTER::.*:beta_quintile_5", names(betahat_full), value = TRUE)
betahat <- betahat_full[event_vars]
sigma   <- sigma_full[event_vars, event_vars]
names(betahat_full)
quarter_vals <- as.numeric(sub("QUARTER::(-?[0-9]+):.*", "\\1", event_vars))
ord <- order(quarter_vals)
betahat <- betahat[ord]
sigma   <- sigma[ord, ord]
quarter_vals_sorted <- quarter_vals[ord]
numPrePeriods  <- sum(quarter_vals_sorted < -1)
numPostPeriods <- sum(quarter_vals_sorted > -1)
delta_rm_results <- createSensitivityResults_relativeMagnitudes(
betahat        = betahat,
sigma          = sigma,
numPrePeriods  = numPrePeriods,
numPostPeriods = numPostPeriods,
Mbarvec        = seq(0.5, 2, by = 0.5)
)
originalResults <- constructOriginalCS(
betahat        = betahat,
sigma          = sigma,
numPrePeriods  = numPrePeriods,
numPostPeriods = numPostPeriods
)
createSensitivityPlot_relativeMagnitudes(delta_rm_results, originalResults)
