geom_smooth(method = "lm", se = TRUE, color = okabe_ito[1], fullrange = TRUE) +
coord_fixed(ratio = 1) +
scale_x_continuous(limits = c(0, 1)) +
scale_y_continuous(limits = c(0, 1)) +
labs(x = TeX("$\\beta$ Score"), y = NULL, title = NULL) +
theme(
