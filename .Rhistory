prep_honestdid <- function(mod, event_var, treat_var, ref = -1) {
betahat_full <- coef(mod)
sigma_full   <- vcov(mod)
pattern <- paste0(event_var, "::.*:", treat_var)
event_vars <- grep(pattern, names(betahat_full), value = TRUE)
quarter_vals <- as.numeric(sub(paste0(event_var, "::(-?[0-9]+):.*"), "\\1", event_vars))
ord <- order(quarter_vals)
betahat <- betahat_full[event_vars][ord]
sigma   <- sigma_full[event_vars, event_vars][ord, ord]
qv      <- quarter_vals[ord]
list(
betahat        = betahat,
sigma          = sigma,
numPrePeriods  = sum(qv < ref),
numPostPeriods = sum(qv > ref),
quarter_vals   = qv
)
}
prepped <- prep_honestdid(lm.fit, "QUARTER", "beta_quintile_5")
originalResults <- constructOriginalCS(
betahat = prepped$betahat, sigma = prepped$sigma,
numPrePeriods = prepped$numPrePeriods, numPostPeriods = prepped$numPostPeriods,
l_vec = rep(1/prepped$numPostPeriods, prepped$numPostPeriods)
)
delta_rm_results <- createSensitivityResults_relativeMagnitudes(
betahat        = prepped$betahat,
sigma          = prepped$sigma,
numPrePeriods  = prepped$numPrePeriods,
numPostPeriods = prepped$numPostPeriods,
Mbarvec        = seq(0.5, 2, by = 0.5),
l_vec          = rep(1/prepped$numPostPeriods, prepped$numPostPeriods)
)
