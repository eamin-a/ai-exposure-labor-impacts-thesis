# Set probability of success
p <- 0.2
failures <- 0:10
# Calculate PMF (probability of x failures before 1st success)
pmf <- dgeom(x = failures, prob = p)
# Create data frame for visualization
df <- data.frame(failures, pmf)
# Base R Barplot
barplot(
height = df$pmf,
names.arg = df$failures,
xlab = "Number of Failures Before First Success",
ylab = "Probability",
main = paste0("Geometric Distribution (p = ", p, ")"),
col = "lightblue",
border = "darkblue"
)
# Set probability of success
p <- 0.02
failures <- 0:10
# Calculate PMF (probability of x failures before 1st success)
pmf <- dgeom(x = failures, prob = p)
# Create data frame for visualization
df <- data.frame(failures, pmf)
# Base R Barplot
barplot(
height = df$pmf,
names.arg = df$failures,
xlab = "Number of Failures Before First Success",
ylab = "Probability",
main = paste0("Geometric Distribution (p = ", p, ")"),
col = "lightblue",
border = "darkblue"
)
# Set probability of success (small p produces a long tail)
p <- 0.05
failures <- 0:80
# Calculate CDF (cumulative probability of <= x failures)
cdf <- pgeom(q = failures, prob = p)
# Plot CDF showing the long tail
barplot(
height = cdf,
names.arg = failures,
xlab = "Number of Failures Before First Success",
ylab = "Cumulative Probability P(X <= x)",
main = paste0("Geometric Cumulative Distribution Function (p = ", p, ")"),
col = "skyblue",
border = "steelblue"
)
# Set probability of success (small p produces a long tail)
p <- 0.0005
failures <- 0:100
# Calculate CDF (cumulative probability of <= x failures)
cdf <- pgeom(q = failures, prob = p)
# Plot CDF showing the long tail
barplot(
height = cdf,
names.arg = failures,
xlab = "Number of Failures Before First Success",
ylab = "Cumulative Probability P(X <= x)",
main = paste0("Geometric Cumulative Distribution Function (p = ", p, ")"),
col = "skyblue",
border = "steelblue"
)
# Set probability of success (small p produces a long tail)
p <- 0.001
failures <- 0:100
# Calculate CDF (cumulative probability of <= x failures)
cdf <- pgeom(q = failures, prob = p)
# Plot CDF showing the long tail
barplot(
height = cdf,
names.arg = failures,
xlab = "Number of Failures Before First Success",
ylab = "Cumulative Probability P(X <= x)",
main = paste0("Geometric Cumulative Distribution Function (p = ", p, ")"),
col = "skyblue",
border = "steelblue"
)
# Set probability of success (small p produces a long tail)
p <- (1/150)
failures <- 0:100
# Calculate CDF (cumulative probability of <= x failures)
cdf <- pgeom(q = failures, prob = p)
# Plot CDF showing the long tail
barplot(
height = cdf,
names.arg = failures,
xlab = "Number of Failures Before First Success",
ylab = "Cumulative Probability P(X <= x)",
main = paste0("Geometric Cumulative Distribution Function (p = ", p, ")"),
col = "skyblue",
border = "steelblue"
)
